# Deploying to Vercel: don't commit a real .env.production — set these same
# keys as Environment Variables in the Vercel project dashboard instead
# (Project Settings -> Environment Variables, scope = Production). Vercel
# rebuilds on every push, so CRA bakes them in automatically at that point.
#
# Building/testing locally instead: copy this to .env.production
# (same directory as package.json) before `npm run build`. CRA bakes
# REACT_APP_* values in at build time — changing them afterwards requires
# a rebuild, not just a server restart. Never commit the real file.

NODE_ENV=production

# Bare origin only — service calls already prepend /api/... themselves.
# This is the DigitalOcean droplet's API domain (see deploy/nginx), not Vercel's.
REACT_APP_BACKEND_URL=https://api-furniture.duckdns.org

REACT_APP_ROUTER_BASE_NAME=

# Social login
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_FACEBOOK_APP_ID=
